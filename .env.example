# Copy to .env and adjust. Every value below is optional — the defaults run the
# full pipeline against the local mock services with the mock LLM provider.

# --- LLM provider ---------------------------------------------------------
# auto | anthropic | openai | mock
#   auto  -> use the first provider with an API key present, else mock
#   mock  -> never call out; deterministic templated answers
LLM_PROVIDER=auto

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o-mini

# --- Upstream services ----------------------------------------------------
# Point these at the mock_services app (docker compose wires them up).
USER_SERVICE_URL=http://localhost:8001
KUNDLI_SERVICE_URL=http://localhost:8001
HOROSCOPE_SERVICE_URL=http://localhost:8001
PANCHANG_SERVICE_URL=http://localhost:8001

# --- Prompt budget --------------------------------------------------------
# Ceiling on tokens spent on *selected context* in the prompt. Context items are
# admitted by descending relevance until this is exhausted.
CONTEXT_TOKEN_BUDGET=600

# --- Dev affordances ------------------------------------------------------
# Exposes DELETE /_cache. Must stay false in production: a public cache flush
# lets anyone stampede the upstream services.
ENABLE_ADMIN_ENDPOINTS=true

LOG_LEVEL=INFO
